# Copy to /etc/aqi-bot/aqi-bot.env and chmod 600. Never commit the real file.

# --- Required ---
# From @BotFather.
TELEGRAM_BOT_TOKEN=123456789:replace-me
# Your chat id. Message the bot, then GET /getUpdates to read it back.
TELEGRAM_CHAT_ID=000000000
# Coordinates of the place you actually care about.
AQI_LAT=0.0000
AQI_LON=0.0000

# --- Optional ---
# Free token from https://aqicn.org/data-platform/token/ .
# Without it the bot silently uses Open-Meteo only.
WAQI_TOKEN=
# Shown in the alert text. Quote any value containing spaces or commas:
# systemd copes with them unquoted, but `. aqi-bot.env` in a shell will not.
AQI_LOCATION_NAME="Home"
# Lowest band that is worth a message. 0=Good 1=Moderate 2=USG 3=Unhealthy
# 4=Very Unhealthy 5=Hazardous. Default 2 means "tell me once AQI passes 100".
AQI_ALERT_FLOOR_BAND=2
# Points a reading must clear a band boundary by before the change is accepted.
AQI_DEADBAND=3
# Who may query the bot interactively. Comma-separated Telegram user ids.
# Defaults to TELEGRAM_CHAT_ID. Anyone else is ignored.
TELEGRAM_ALLOWED_USER_IDS=
AQI_STATE_FILE=/var/lib/aqi-bot/state.json
AQI_OFFSET_FILE=/var/lib/aqi-bot/offset.json
LOG_LEVEL=INFO
